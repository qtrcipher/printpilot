{
  "name": "printpilot",
  "version": "0.1.1",
  "description": "Open source desktop recovery console for operating a network printer's menu when its control panel is unusable.",
  "license": "GPL-3.0-only",
  "author": "Hamam Alabdulla <hamam@gccapps.com>",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "screenshots": "npm run build && PRINTPILOT_SCREENSHOTS=1 playwright test e2e/screenshots.spec.ts",
    "package": "npm run build && electron-builder --dir",
    "icon": "node scripts/build-icon.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "bonjour-service": "^1.4.4",
    "net-snmp": "^3.26.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "jsdom": "^30.0.1",
    "playwright": "1.62.1",
    "sharp": "0.35.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
