{
  "name": "printpilot",
  "version": "0.1.0",
  "description": "Open source desktop recovery console for operating a network printer's menu when its control panel is unusable.",
  "license": "GPL-3.0-only",
  "author": "PrintPilot contributors",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "package": "npm run build && electron-builder --dir",
    "icon": "node scripts/build-icon.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "electron": "43.4.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "playwright": "1.62.1",
    "sharp": "0.35.3",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  }
}
